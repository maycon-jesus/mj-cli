{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "Debug CLI",
            "type": "go",
            "request": "launch",
            "mode": "auto",
            "program": "${workspaceFolder}",
            "args": [],
            "cwd": "${workspaceFolder}",
            "env": {
                "DEBUG": "1"
            }
        },
        {
            "name": "Debug CLI (com args)",
            "type": "go",
            "request": "launch",
            "mode": "auto",
            "program": "${workspaceFolder}",
            "args": [
                "${input:cliArgs}"
            ],
            "cwd": "${workspaceFolder}",
            "env": {
                "DEBUG": "1"
            }
        }
    ],
    "inputs": [
        {
            "id": "cliArgs",
            "type": "promptString",
            "description": "Argumentos do CLI (ex: config set lang pt-BR)"
        }
    ]
}